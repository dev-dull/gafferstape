{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": [
    "solar",
    "gafferstape",
    "energy"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "title": "GAF Solar Energy",
  "uid": "gafferstape-solar",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Session Expires In",
      "description": "Time remaining before GAF Energy session cookies expire. GAF mints ~24h JWTs, so tokens must be manually rotated roughly daily.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "yellow",
                "value": 14400
              },
              {
                "color": "green",
                "value": 43200
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "max(gaf_session_expires_seconds{job=\"gafferstape\"})",
          "legendFormat": "Time to expiry",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 11,
      "title": "Current Generation",
      "description": "Current hourly production vs theoretical maximum (~6 kW rated inverter capacity).",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 7,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "min": 0,
          "max": 6,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"})",
          "legendFormat": "Current",
          "refId": "A"
        },
        {
          "expr": "max(avg_over_time(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"}[7d]))",
          "legendFormat": "7d avg",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 2,
      "title": "Exporter Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 13,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "max(gaf_up{job=\"gafferstape\"})",
          "legendFormat": "Status",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 4,
      "title": "Last Data Sample",
      "description": "How long ago the most recent data point was received from the GAF API.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "orange",
                "value": 7200
              },
              {
                "color": "red",
                "value": 14400
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "time() - max(gaf_last_sample_timestamp_seconds{job=\"gafferstape\"} > 0)",
          "legendFormat": "Age",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 5,
      "title": "Daily Production",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "drawStyle": "line",
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Today"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Yesterday"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "7d avg"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_today{job=\"gafferstape\"})",
          "legendFormat": "Today",
          "refId": "A"
        },
        {
          "expr": "max(gaf_energy_production_kwh_yesterday{job=\"gafferstape\"})",
          "legendFormat": "Yesterday",
          "refId": "B"
        },
        {
          "expr": "avg_over_time(gaf_energy_production_kwh_yesterday{job=\"gafferstape\"}[7d])",
          "legendFormat": "7d avg (completed days)",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 7,
      "title": "Current Hour",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-yellow",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "dark-green",
                "value": 4
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"})",
          "legendFormat": "This hour",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 12,
      "title": "Peak Today",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-yellow",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              },
              {
                "color": "dark-green",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "max(max_over_time(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"}[24h]))",
          "legendFormat": "Peak",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 15,
      "title": "Current Hour + Peak",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "line",
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hourly"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "24h peak"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"})",
          "legendFormat": "Hourly",
          "refId": "A"
        },
        {
          "expr": "max(max_over_time(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"}[24h]))",
          "legendFormat": "24h peak",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 8,
      "title": "Daily Production History",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "drawStyle": "line",
            "gradientMode": "scheme"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_today{job=\"gafferstape\"})",
          "legendFormat": "Today (cumulative)",
          "refId": "A"
        },
        {
          "expr": "max(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"})",
          "legendFormat": "Hourly production",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 13,
      "title": "Weekly Production",
      "description": "Daily kWh totals over the past 7 completed days. Each step holds a single day's value; the marker sits at the start of that day. Today is excluded — see the Daily Production panel for in-progress production.",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "min": 0,
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 9,
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisPlacement": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "hidden"
        }
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_yesterday{job=\"gafferstape\"})",
          "legendFormat": "Daily total (completed days)",
          "refId": "A",
          "interval": "1d"
        }
      ],
      "timeFrom": "7d",
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 14,
      "title": "Production Heatmap",
      "description": "Hourly production intensity over the past 7 days. Reveals peak generation hours and weather patterns. Extend the time range via the time picker for more history once you have it.",
      "type": "heatmap",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {}
      },
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": {
            "mode": "size",
            "value": "1h"
          },
          "yBuckets": {
            "mode": "size",
            "value": "0.5"
          }
        },
        "color": {
          "mode": "scheme",
          "scheme": "YlGn",
          "steps": 64
        },
        "cellGap": 1,
        "yAxis": {
          "unit": "kwatth"
        },
        "tooltip": {
          "show": true
        }
      },
      "targets": [
        {
          "expr": "max(gaf_energy_production_kwh_latest_hour{job=\"gafferstape\"})",
          "legendFormat": "Production",
          "refId": "A",
          "interval": "1h"
        }
      ],
      "timeFrom": "7d",
      "datasource": {
        "type": "prometheus"
      }
    },
    {
      "id": 10,
      "title": "Scrape Errors",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(increase(gaf_scrape_errors_total{job=\"gafferstape\"}[1h]))",
