# Copy to .env and paste the cookie values from a Firefox login at
# my.gaf.energy. Both are required for the poller to start; with
# either missing the daemon falls back to /healthz-only mode.
#
# These are read by docker-compose.yaml and injected into the
# container as env vars. The exporter's config loader treats env vars
# as overrides over config.yaml, so config.yaml can keep these blank.
#
# The cookies expire roughly every 25 days — refresh from a browser
# session and restart the container when /api/state starts returning
# ok=false with an "authentication failed" error.
#
# The full walkthrough lands with issue #7 (end-user setup docs).

GAFFERSTAPE_SESSION_TOKEN=
GAFFERSTAPE_CSRF_TOKEN=
